{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StorageEnvelope v1 — Production Local-First (prompt.md compliant)",
  "type": "object",
  "required": ["version", "exportedAt", "wordsMeta", "userProfile", "wordProgress", "attempts", "sessions", "streak", "gamification", "settings", "dailyProgress", "userWords", "hiddenWordIds", "metaLearning", "activeLearningSession"],
  "properties": {
    "version": { "type": "integer", "const": 1, "description": "STORAGE_VERSION — bump triggers migration in migrateEnvelope()" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "wordsMeta": { "type": "object", "required": ["count", "sourceHash"], "properties": { "count": { "type": "integer" }, "sourceHash": { "type": "string" } } },
    "userProfile": { "$ref": "#/definitions/UserProfile" },
    "wordProgress": { "type": "object", "additionalProperties": { "$ref": "#/definitions/WordProgress" } },
    "attempts": { "type": "array", "items": { "$ref": "#/definitions/Attempt" }, "maxItems": 5000 },
    "sessions": { "type": "array", "items": { "$ref": "#/definitions/Session" } },
    "streak": { "$ref": "#/definitions/Streak" },
    "gamification": { "$ref": "#/definitions/Gamification" },
    "settings": { "$ref": "#/definitions/Settings" },
    "dailyProgress": { "type": "object", "additionalProperties": { "$ref": "#/definitions/DailyProgress" } },
    "userWords": { "type": "array", "items": { "$ref": "#/definitions/Word" }, "description": "Per-browser custom words (local-first isolation)" },
    "hiddenWordIds": { "type": "array", "items": { "type": "string" } },
    "metaLearning": { "$ref": "#/definitions/MetaLearning" },
    "activeLearningSession": { "type": ["object", "null"], "$ref": "#/definitions/LearningSession" }
  },
  "definitions": {
    "UserProfile": {
      "type": "object",
      "required": ["id", "name", "onboardingCompleted", "createdAt"],
      "properties": {
        "id": { "type": "string", "description": "stable per-browser, e.g. local-user or uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "onboardingCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "WordProgress": {
      "type": "object",
      "required": ["wordId", "attempts", "correct", "wrong", "accuracy", "masteryScore", "masteryTier", "state", "currentStreak", "bestStreak", "consecutiveCorrect", "consecutiveWrong"],
      "properties": {
        "wordId": { "type": "string" },
        "attempts": { "type": "integer", "minimum": 0 },
        "correct": { "type": "integer", "minimum": 0 },
        "wrong": { "type": "integer", "minimum": 0 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 100 },
        "masteryScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "masteryTier": { "enum": ["critical", "weak", "learning", "strong", "mastered"] },
        "state": { "enum": ["UNSEEN", "LEARNING", "WEAK", "IMPROVING", "STRONG", "MASTERED"] },
        "currentStreak": { "type": "integer" },
        "bestStreak": { "type": "integer" },
        "consecutiveCorrect": { "type": "integer" },
        "consecutiveWrong": { "type": "integer" },
        "lastPracticedISO": { "type": ["string", "null"] },
        "lastAttemptAt": { "type": ["string", "null"] },
        "lastCorrectAt": { "type": ["string", "null"] },
        "lastWrongAt": { "type": ["string", "null"] },
        "nextReviewAt": { "type": ["string", "null"] },
        "avgResponseMs": { "type": ["number", "null"] },
        "totalResponseMs": { "type": "number" },
        "mistakeHistogram": { "type": "object" },
        "lastMistakeType": { "type": "string" },
        "historicalMastery": { "type": "number" }
      }
    },
    "Attempt": {
      "type": "object",
      "required": ["id", "wordId", "timestampISO", "typed", "normalizedTyped", "isCorrect", "responseMs", "mode"],
      "properties": {
        "id": { "type": "string" },
        "wordId": { "type": "string" },
        "timestampISO": { "type": "string" },
        "typed": { "type": "string" },
        "normalizedTyped": { "type": "string" },
        "isCorrect": { "type": "boolean" },
        "responseMs": { "type": "number" },
        "mode": { "type": "string" },
        "mistakeType": { "type": "string" }
      }
    },
    "Session": {
      "type": "object",
      "required": ["id", "mode", "startedAt", "wordIds", "results", "correctCount", "wrongCount", "xpEarned"],
      "properties": {
        "id": { "type": "string" },
        "mode": { "type": "string" },
        "startedAt": { "type": "string" },
        "endedAt": { "type": ["string", "null"] },
        "wordIds": { "type": "array", "items": { "type": "string" } },
        "results": { "type": "array" },
        "correctCount": { "type": "integer" },
        "wrongCount": { "type": "integer" },
        "xpEarned": { "type": "integer" }
      }
    },
    "Streak": {
      "type": "object",
      "required": ["current", "longest", "lastPracticeDateISO", "practiceDays", "totalSessions", "history"],
      "properties": {
        "current": { "type": "integer" },
        "longest": { "type": "integer" },
        "lastPracticeDateISO": { "type": ["string", "null"] },
        "practiceDays": { "type": "integer" },
        "totalSessions": { "type": "integer" },
        "history": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Gamification": {
      "type": "object",
      "required": ["xp", "level", "achievements", "personalBests"],
      "properties": {
        "xp": { "type": "integer", "minimum": 0 },
        "level": { "type": "integer", "minimum": 1 },
        "achievements": { "type": "array" },
        "personalBests": { "type": "object" }
      }
    },
    "Settings": {
      "type": "object",
      "required": ["theme", "soundEnabled", "volume", "autoPlay", "slowRate", "dailyGoal", "defaultMode", "adaptiveEnabled", "sessionLength"],
      "properties": {
        "theme": { "enum": ["light", "dark", "system"] },
        "soundEnabled": { "type": "boolean" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "autoPlay": { "type": "boolean" },
        "slowRate": { "type": "boolean" },
        "dailyGoal": { "type": "integer", "minimum": 5, "maximum": 200 },
        "defaultMode": { "type": "string" },
        "adaptiveEnabled": { "type": "boolean" },
        "sessionLength": { "type": "integer", "enum": [10, 20, 30, 50] }
      }
    },
    "DailyProgress": { "type": "object", "required": ["dateISO", "count", "goal"], "properties": { "dateISO": { "type": "string" }, "count": { "type": "integer" }, "goal": { "type": "integer" } } },
    "Word": { "type": "object", "required": ["id", "word", "normalized", "category", "categorySlug"], "properties": { "id": { "type": "string" }, "word": { "type": "string" }, "normalized": { "type": "string" }, "category": { "type": "string" }, "categorySlug": { "type": "string" }, "difficulty": { "enum": ["easy", "medium", "hard"] } } },
    "MetaLearning": { "type": "object" },
    "LearningSession": { "type": "object", "required": ["id", "mode", "wordIds", "currentIndex", "status"], "properties": { "id": { "type": "string" }, "mode": { "type": "string" }, "wordIds": { "type": "array" }, "currentIndex": { "type": "integer" }, "status": { "enum": ["active", "completed"] } } }
  }
}
